# --- Required (boot fails without these) ---
MONGODB_URI=mongodb+srv://user:pass@cluster/sanchartag
JWT_SECRET=use-a-long-random-string

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Sessions ---
# Idle life: token dies if unused this long (sliding refresh renews on activity)
TOKEN_IDLE_DAYS=30
# Absolute cap: no session survives past this
ABSOLUTE_SESSION_DAYS=180
SCAN_TOKEN_TTL_MINUTES=15
# Scanner phone verification validity (rescans within this window skip the OTP)
SCANNER_TOKEN_TTL_DAYS=7
INTERACTION_TOKEN_TTL_HOURS=24

# --- OTP / SMS ---
# false = no SMS provider; OTP is returned in the API response (NEVER in production)
SMS_ENABLED=false
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Fixed OTP for app-store review accounts; unset to disable
# MASTER_OTP=

# --- Console (internal admin API) ---
# Server-to-server key held by the SancharTag Console. Unset = /admin disabled.
# ADMIN_INTERNAL_KEY=use-a-long-random-string

# --- Misc ---
DEFAULT_PHONE_REGION=IN
# Browser origins allowed (scanner web app); mobile apps send no Origin and always pass
CORS_ORIGINS=https://sanchartag-scanner.vercel.app,http://localhost:3000,http://localhost:5173
# LOG_LEVEL=debug
