{
  "name": "sanchartag-server",
  "version": "2.0.0",
  "description": "SancharTag API — privacy-first vehicle QR contact platform",
  "private": true,
  "main": "bin/www",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/www",
    "dev": "nodemon bin/www",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.31",
    "mongoose": "^9.1.6",
    "morgan": "^1.10.0",
    "rate-limiter-flexible": "^5.0.5",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/__tests__/helpers/env.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  }
}
